# ──────────────────────────────────────────────
# User Service — Environment Variables
# Copy this file to .env and fill in your values.
# All variables are validated at startup (config/env.ts); the service exits on invalid config.
# ──────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# HTTP
# comma-separated; empty disables browser CORS
CORS_ORIGINS=http://localhost:3000
# number of proxy hops in front of the service
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000

# Database (PostgreSQL) — docker-compose exposes Postgres on 5433
DATABASE_URL="postgresql://irctc:irctc@localhost:5433/irctc_users?schema=public"

# Kafka
KAFKA_ENABLED=true
# comma-separated
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=user-service
KAFKA_GROUP_ID=user-service-group
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

# Redis (optional) — shared rate-limit counters across replicas. Leave empty to use in-memory limits.
REDIS_URL=redis://localhost:6379
